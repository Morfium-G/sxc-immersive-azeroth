{
  "id": "seyri.immersive-azeroth",
  "name": "Immersive Azeroth",
  "version": "0.1.0",
  "abi": "0.5",
  "description": "Makes the world feel alive: simulation and data-driven sky, climate, fog, covers, lights and wind. Needs an SXC build of the client.",
  "authors": ["Seyri"],
  "binaries": {
    "win-x64": "bin/x64/immersive-azeroth.dll"
  },
  "requires": [
    { "service": "sxc.data", "version": 1 },
    { "service": "sxc.settings", "version": 1 },
    { "service": "sxc.ui", "version": 1 },
    { "service": "sxc.world", "version": 1 },
    { "service": "sxc.sky", "version": 1 }
  ],
  "optional": [
    { "service": "wxl.script", "version": 1 },
    { "service": "sxc.fog", "version": 1 }
  ],
  "loadAfter": ["sxc.bridge"]
}
